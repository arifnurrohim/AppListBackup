<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_layout"
    android:background="?attr/colorBase"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout style="@style/TitleBar">
        <ImageButton
            android:src="@drawable/ic_material_home"
            android:tint="?attr/colorSubtext0"
            android:onClick="onHomeClick"
            android:contentDescription="@string/description_home"
            style="@style/TitleBarAction"/>
        <TextView style="@style/TitleBarText"/>
        <ImageButton
            android:src="@drawable/ic_material_filter_list"
            android:tint="?attr/colorSubtext0"
            android:onClick="onFilterClick"
            android:contentDescription="@string/select_filter_type"
            style="@style/TitleBarAction"/>
        <ImageButton
            android:src="@drawable/ic_material_sort"
            android:tint="?attr/colorSubtext0"
            android:onClick="onSortClick"
            android:contentDescription="@string/sort"
            style="@style/TitleBarAction"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/search_apps"
            android:hint="@string/search_apps"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/AppEditText"/>
        <CheckBox
            android:id="@+id/chk_show_system"
            android:text="@string/system_apps"
            android:textColor="?attr/colorSubtext0"
            android:contentDescription="@string/show_system_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>
    <ListView
        android:id="@android:id/list"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:listSelector="@android:color/transparent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_weight="1"/>
    <TextView
        android:id="@android:id/empty"
        android:text="@string/no_apps"
        style="@style/EmptyText"/>
</LinearLayout>
