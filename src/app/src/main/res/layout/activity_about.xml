<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_layout"
    android:background="?attr/colorBase"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout style="@style/TitleBar">
        <ImageButton
            android:src="@drawable/ic_material_home"
            android:tint="?attr/colorSubtext0"
            android:onClick="onHomeClick"
            android:contentDescription="@string/description_home"
            style="@style/TitleBarAction"/>
        <TextView style="@style/TitleBarText"/>
    </LinearLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="4dp"
            android:paddingRight="16dp"
            android:paddingBottom="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:text="@string/about_section_app"
                style="@style/AboutSectionLabel"/>
            <LinearLayout style="@style/AboutCard">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:src="@drawable/icon"
                        style="@style/AboutAppIcon"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_weight="1">
                        <TextView
                            android:text="@string/app_name"
                            style="@style/AboutAppName"/>
                        <TextView
                            android:text="@string/about_version"
                            style="@style/AboutAppVersion"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:text="@string/about_description"
                    style="@style/AboutDescription"/>
                <View style="@style/AboutDivider"/>
                <LinearLayout
                    android:onClick="onCreatorClick"
                    style="@style/AboutLinkRow">
                    <ImageView
                        android:src="@drawable/ic_person"
                        android:tint="?attr/colorBlue"
                        style="@style/AboutLinkIcon"/>
                    <TextView
                        android:text="@string/about_creator_label"
                        style="@style/AboutLinkLabel"/>
                    <ImageView
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/colorOverlay1"
                        style="@style/AboutExternalIcon"/>
                </LinearLayout>
                <LinearLayout
                    android:onClick="onEmailClick"
                    style="@style/AboutLinkRow">
                    <ImageView
                        android:src="@drawable/ic_email"
                        android:tint="?attr/colorBlue"
                        style="@style/AboutLinkIcon"/>
                    <TextView
                        android:text="@string/about_email_label"
                        style="@style/AboutLinkLabel"/>
                    <ImageView
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/colorOverlay1"
                        style="@style/AboutExternalIcon"/>
                </LinearLayout>
                <LinearLayout
                    android:onClick="onRepositoryClick"
                    style="@style/AboutLinkRow">
                    <ImageView
                        android:src="@drawable/ic_material_link"
                        android:tint="?attr/colorBlue"
                        style="@style/AboutLinkIcon"/>
                    <TextView
                        android:text="@string/about_repo_label"
                        style="@style/AboutLinkLabel"/>
                    <ImageView
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/colorOverlay1"
                        style="@style/AboutExternalIcon"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:text="@string/about_section_credits"
                style="@style/AboutSectionLabel"/>
            <LinearLayout style="@style/AboutCard">
                <LinearLayout
                    android:onClick="onCatppuccinClick"
                    style="@style/AboutLinkRow">
                    <ImageView
                        android:src="@drawable/ic_palette"
                        android:tint="?attr/colorBlue"
                        style="@style/AboutLinkIcon"/>
                    <TextView
                        android:text="@string/about_catppuccin_label"
                        style="@style/AboutLinkLabel"/>
                    <ImageView
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/colorOverlay1"
                        style="@style/AboutExternalIcon"/>
                </LinearLayout>
                <View style="@style/AboutDivider"/>
                <LinearLayout
                    android:onClick="onMaterialClick"
                    style="@style/AboutLinkRow">
                    <ImageView
                        android:src="@drawable/ic_material_palette"
                        android:tint="?attr/colorBlue"
                        style="@style/AboutLinkIcon"/>
                    <TextView
                        android:text="@string/about_material_label"
                        style="@style/AboutLinkLabel"/>
                    <ImageView
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/colorOverlay1"
                        style="@style/AboutExternalIcon"/>
                </LinearLayout>
                <LinearLayout
                    android:onClick="onMaterialSymbolsClick"
                    style="@style/AboutLinkRow">
                    <ImageView
                        android:src="@drawable/ic_material_link"
                        android:tint="?attr/colorBlue"
                        style="@style/AboutLinkIcon"/>
                    <TextView
                        android:text="@string/about_material_symbols_label"
                        style="@style/AboutLinkLabel"/>
                    <ImageView
                        android:src="@drawable/ic_open_in_new"
                        android:tint="?attr/colorOverlay1"
                        style="@style/AboutExternalIcon"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:text="@string/about_disclaimer"
                style="@style/AboutDisclaimer"/>
            <TextView
                android:text="@string/about_footer"
                style="@style/AboutFooter"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
