<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/main_layout"
    android:background="?attr/colorBase"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout style="@style/TitleBar">
        <TextView style="@style/TitleBarText"/>
    </LinearLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="18dp"
            android:paddingRight="20dp"
            android:paddingBottom="28dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="26sp"
                android:textColor="?attr/colorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your apps, organized."
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorSubtext0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Create a clean backup of your installed apps, or browse a previous list."
                android:lineSpacingExtra="3dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <LinearLayout
                    android:id="@+id/dashboard_btn_backup"
                    android:layout_marginRight="8dp"
                    android:onClick="onBackupClick"
                    style="@style/DashboardCard">
                    <ImageView
                        android:background="@drawable/bg_icon_mauve"
                        android:src="@drawable/ic_material_backup"
                        android:tint="?attr/colorAccent"
                        style="@style/DashboardIcon"/>
                    <TextView
                        android:text="@string/backup"
                        style="@style/DashboardCardTitle"/>
                    <TextView
                        android:text="Select installed apps and save a list."
                        style="@style/DashboardCardSubtitle"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dashboard_btn_view"
                    android:layout_marginLeft="8dp"
                    android:onClick="onViewClick"
                    style="@style/DashboardCard">
                    <ImageView
                        android:background="@drawable/bg_icon_blue"
                        android:src="@drawable/ic_material_view"
                        android:tint="?attr/colorBlue"
                        style="@style/DashboardIcon"/>
                    <TextView
                        android:text="@string/view"
                        style="@style/DashboardCardTitle"/>
                    <TextView
                        android:text="Open a saved app list."
                        style="@style/DashboardCardSubtitle"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <LinearLayout
                    android:id="@+id/dashboard_btn_preference"
                    android:layout_marginRight="8dp"
                    android:onClick="onPreferenceClick"
                    style="@style/DashboardCard">
                    <ImageView
                        android:background="@drawable/bg_icon_green"
                        android:src="@drawable/ic_material_settings"
                        android:tint="?attr/colorGreen"
                        style="@style/DashboardIcon"/>
                    <TextView
                        android:text="@string/preferences"
                        style="@style/DashboardCardTitle"/>
                    <TextView
                        android:text="Storage and sorting."
                        style="@style/DashboardCardSubtitle"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/dashboard_btn_help"
                    android:layout_marginLeft="8dp"
                    android:onClick="onHelpClick"
                    style="@style/DashboardCard">
                    <ImageView
                        android:background="@drawable/bg_icon_peach"
                        android:src="@drawable/ic_material_help"
                        android:tint="?attr/colorPeach"
                        style="@style/DashboardIcon"/>
                    <TextView
                        android:text="@string/help"
                        style="@style/DashboardCardTitle"/>
                    <TextView
                        android:text="Open the help page."
                        style="@style/DashboardCardSubtitle"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_ripple"
                android:padding="16dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:onClick="onAboutClick">
                <ImageView
                    android:background="@drawable/bg_icon_lavender"
                    android:src="@drawable/ic_material_info"
                    android:tint="?attr/colorLavender"
                    style="@style/DashboardIcon"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="14dp"
                    android:layout_weight="1">
                    <TextView
                        android:layout_marginTop="0dp"
                        android:text="@string/about"
                        style="@style/DashboardCardTitle"/>
                    <TextView
                        android:text="@string/about_creator_line"
                        style="@style/DashboardCardSubtitle"/>
                    <TextView
                        android:layout_marginTop="2dp"
                        android:text="@string/about_email_line"
                        style="@style/DashboardCardSubtitle"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_material_chevron_right"
                    android:tint="?attr/colorOverlay1"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="?attr/colorOverlay1"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Catppuccin"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
